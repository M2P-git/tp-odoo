<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biblio_livre_view_list" model="ir.ui.view">
        <field name="name">biblio.livre.list</field>
        <field name="model">biblio.livre</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="auteur_ids" widget="many2many_tags"/>
                <field name="genre"/>
                <field name="annee"/>
                <field name="nb_exemplaires"/>
                <field name="nb_disponibles"/>
            </list>
        </field>
    </record>

    <record id="biblio_livre_view_form" model="ir.ui.view">
        <field name="name">biblio.livre.form</field>
        <field name="model">biblio.livre</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Titre du livre"/></h1>
                    </div>
                    <group>
                        <group string="Le livre">
                            <field name="auteur_ids" widget="many2many_tags"/>
                            <field name="genre"/>
                            <field name="annee"/>
                            <field name="isbn"/>
                        </group>
                        <group string="Les exemplaires">
                            <field name="nb_exemplaires"/>
                            <field name="nb_empruntes"/>
                            <field name="nb_disponibles"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Emprunts" name="emprunts">
                            <field name="emprunt_ids" readonly="1">
                                <list>
                                    <field name="adherent_id"/>
                                    <field name="date_emprunt"/>
                                    <field name="date_retour_prevue"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Résumé" name="resume">
                            <field name="resume" placeholder="De quoi parle ce livre ?"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biblio_livre_view_search" model="ir.ui.view">
        <field name="name">biblio.livre.search</field>
        <field name="model">biblio.livre</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="auteur_ids"/>
                <field name="isbn"/>
                <filter name="informatique" string="Informatique" domain="[('genre', '=', 'informatique')]"/>
                <filter name="gestion" string="Gestion" domain="[('genre', '=', 'gestion')]"/>
                <group>
                    <filter name="par_genre" string="Genre" context="{'group_by': 'genre'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="biblio_livre_action" model="ir.actions.act_window">
        <field name="name">Livres</field>
        <field name="res_model">biblio.livre</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
